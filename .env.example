# =========================================================
# PostgreSQL
# =========================================================
# Host-side Python uses localhost.
# Compose overrides POSTGRES_HOST to the postgres service name.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=dataengineer
POSTGRES_PASSWORD=change_me
POSTGRES_CONTAINER=incident-postgres

# =========================================================
# MinIO
# =========================================================

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me

# =========================================================
# Marquez / OpenLineage
# =========================================================

MARQUEZ_DB_PASSWORD=change_me
MARQUEZ_URL=http://localhost:5000
MARQUEZ_NAMESPACE=incident-platform

# =========================================================
# Neo4j lineage graph
# =========================================================
# Host-side default. Compose overrides NEO4J_URI for the worker.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# =========================================================
# Airflow
# =========================================================

AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# =========================================================
# Gemini RCA provider
# =========================================================
# Required before autonomous non-dry-run RCA/recovery.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# =========================================================
# Detection configuration
# =========================================================

NULL_SPIKE_THRESHOLD=0.05

# =========================================================
# Autonomous recovery worker
# =========================================================
# Safe deployment default: dry-run enabled.

INCIDENT_WORKER_POLL_INTERVAL_SECONDS=10
INCIDENT_WORKER_MAX_INCIDENTS_PER_CYCLE=1
INCIDENT_WORKER_DRY_RUN=true
INCIDENT_WORKER_MAX_AUTONOMOUS_ATTEMPTS=3
INCIDENT_WORKER_QUEUE_CLAIM_SECONDS=300
INCIDENT_WORKER_QUEUE_HEARTBEAT_INTERVAL_SECONDS=60
INCIDENT_WORKER_RETRY_BASE_SECONDS=60
INCIDENT_WORKER_RETRY_MAX_SECONDS=1800
