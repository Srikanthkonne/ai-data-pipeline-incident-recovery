# =========================================================
# PostgreSQL
# =========================================================
# Host-side Python uses localhost.
# Compose overrides POSTGRES_HOST to the postgres service name.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=dataengineer
POSTGRES_PASSWORD=change_me
POSTGRES_CONTAINER=incident-postgres

# =========================================================
# MinIO
# =========================================================

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me

# =========================================================
# Marquez / OpenLineage
# =========================================================

MARQUEZ_DB_PASSWORD=change_me
MARQUEZ_URL=http://localhost:5000
MARQUEZ_NAMESPACE=incident-platform

# =========================================================
# Neo4j lineage graph
# =========================================================
# Host-side default. Compose overrides NEO4J_URI for the worker.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# =========================================================
# Airflow
# =========================================================

AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# =========================================================
# Gemini RCA provider
# =========================================================
# Required before autonomous non-dry-run RCA/recovery.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# =========================================================
# Detection configuration
# =========================================================

NULL_SPIKE_THRESHOLD=0.05

# =========================================================
# Autonomous recovery worker
# =========================================================
# Safe deployment default: dry-run enabled.

INCIDENT_WORKER_POLL_INTERVAL_SECONDS=10
INCIDENT_WORKER_MAX_INCIDENTS_PER_CYCLE=1
INCIDENT_WORKER_DRY_RUN=true
INCIDENT_WORKER_MAX_AUTONOMOUS_ATTEMPTS=3
INCIDENT_WORKER_QUEUE_CLAIM_SECONDS=300
INCIDENT_WORKER_QUEUE_HEARTBEAT_INTERVAL_SECONDS=60
INCIDENT_WORKER_RETRY_BASE_SECONDS=60
INCIDENT_WORKER_RETRY_MAX_SECONDS=1800

# =========================================================
# Recovery execution backend
# =========================================================

# Safe default preserves the local Docker + Spark runtime.
# Phase 5B cloud option: emr-serverless.
RECOVERY_EXECUTION_BACKEND=local-docker

# AWS credentials are intentionally NOT stored here.
# boto3 uses the standard AWS credential provider chain.
AWS_REGION=us-east-1

# Required only when RECOVERY_EXECUTION_BACKEND=emr-serverless.
EMR_SERVERLESS_APPLICATION_ID=
EMR_SERVERLESS_EXECUTION_ROLE_ARN=
EMR_SERVERLESS_ARTIFACT_BUCKET=
EMR_SERVERLESS_ARTIFACT_PREFIX=incident-recovery

# =========================================================
# Recovery data storage
# =========================================================

# Local Docker default:
RECOVERY_STORAGE_BACKEND=minio

# Local defaults preserve the existing MinIO paths.
# EMR Serverless will override these with s3:// paths.
RECOVERY_SILVER_PATH=s3a://data-platform/silver/transactions
RECOVERY_BACKUP_PATH=s3a://data-platform/failure-backups/schema-drift/silver-transactions
RECOVERY_TEMP_PATH=s3a://data-platform/failure-temp/schema-drift-restore/silver-transactions

# Used only when RECOVERY_STORAGE_BACKEND=minio.
MINIO_ENDPOINT=http://minio:9000

# Local schema validation evidence output.
# EMR Serverless uses a generated S3 evidence URI instead.
RECOVERY_SCHEMA_EVIDENCE_PATH=/opt/spark/work-dir/evidence/silver_schema.json
RECOVERY_DATASET_NAMESPACE=s3://data-platform
RECOVERY_DATASET_NAME=silver/transactions
